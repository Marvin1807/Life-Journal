{
 "duration": 82.96,
 "lines": [
  {
   "line": 0,
   "t0": 0.2,
   "t1": 2.21,
   "text": "Was, wenn das Internet schon lange tot ist?"
  },
  {
   "line": 1,
   "t0": 2.51,
   "t1": 4.936,
   "text": "Und du einer der letzten echten Menschen in deinem Feed bist?"
  },
  {
   "line": 2,
   "t0": 5.436,
   "t1": 6.101,
   "text": "Klingt verrückt."
  },
  {
   "line": 3,
   "t0": 6.301,
   "t1": 12.07,
   "text": "Aber genau das behauptet eine Theorie, die 2021 in einem kleinen Internetforum auftauchte."
  },
  {
   "line": 4,
   "t0": 12.37,
   "t1": 13.605,
   "text": "Die Dead- Internet- Theorie."
  },
  {
   "line": 5,
   "t0": 13.955,
   "t1": 17.94,
   "text": "Sie besagt: Das meiste, was du online siehst, stammt gar nicht mehr von Menschen."
  },
  {
   "line": 6,
   "t0": 18.09,
   "t1": 19.009,
   "text": "Sondern von Bots."
  },
  {
   "line": 7,
   "t0": 19.409,
   "t1": 23.474,
   "text": "Programme, die posten, liken, kommentieren und sich gegenseitig antworten."
  },
  {
   "line": 8,
   "t0": 23.624,
   "t1": 24.361,
   "text": "Rund um die Uhr."
  },
  {
   "line": 9,
   "t0": 24.811,
   "t1": 26.868,
   "text": "Lange Zeit klang das nach einer Verschwörung."
  },
  {
   "line": 10,
   "t0": 27.068,
   "t1": 28.146,
   "text": "Dann kamen die Zahlen."
  },
  {
   "line": 11,
   "t0": 28.546,
   "t1": 34.057,
   "text": "2024 kam zum ersten Mal seit zehn Jahren mehr Internetverkehr von Bots als von Menschen."
  },
  {
   "line": 12,
   "t0": 34.307,
   "t1": 39.039,
   "text": "51 Prozent. So steht es im Bad- Bot- Report der Sicherheitsfirma Imperva."
  },
  {
   "line": 13,
   "t0": 39.339,
   "t1": 44.472,
   "text": "Und 37 Prozent des gesamten Verkehrs stammten von Bots, die Schaden anrichten sollen."
  },
  {
   "line": 14,
   "t0": 44.872,
   "t1": 50.028,
   "text": "Seit KI Texte, Bilder und Stimmen in Sekunden erzeugt, wird der Unterschied immer schwerer zu erkennen."
  },
  {
   "line": 15,
   "t0": 50.328,
   "t1": 53.815,
   "text": "Europol zitierte schon 2022 eine Schätzung:"
  },
  {
   "line": 16,
   "t0": 53.965,
   "t1": 59.862,
   "text": "Bis 2026 könnten bis zu 90 Prozent aller Inhalte im Netz künstlich erzeugt sein."
  },
  {
   "line": 17,
   "t0": 60.312,
   "t1": 61.989,
   "text": "2026."
  },
  {
   "line": 18,
   "t0": 62.339,
   "t1": 63.031,
   "text": "Das ist jetzt."
  },
  {
   "line": 19,
   "t0": 63.631,
   "t1": 64.414,
   "text": "Du glaubst mir nicht?"
  },
  {
   "line": 20,
   "t0": 64.664,
   "t1": 67.8,
   "text": "Geh unter irgendein virales Video und lies die Kommentare."
  },
  {
   "line": 21,
   "t0": 67.95,
   "t1": 69.893,
   "text": "Achte darauf, wie viele fast gleich klingen."
  },
  {
   "line": 22,
   "t0": 70.393,
   "t1": 73.712,
   "text": "Und wenn du das nächste Mal einen Streit in den Kommentaren liest, frag dich:"
  },
  {
   "line": 23,
   "t0": 73.912,
   "t1": 75.185,
   "text": "Streiten da gerade Menschen?"
  },
  {
   "line": 24,
   "t0": 75.485,
   "t1": 77.586,
   "text": "Oder nur Maschinen, die für dich Menschen spielen?"
  },
  {
   "line": 25,
   "t0": 78.486,
   "t1": 79.394,
   "text": "Ach, übrigens."
  },
  {
   "line": 26,
   "t0": 79.744,
   "t1": 81.76,
   "text": "Diese Stimme hier gehört auch keinem Menschen."
  }
 ],
