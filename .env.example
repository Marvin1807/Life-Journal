# Verbindungsstring deiner PostgreSQL-Datenbank (Supabase, Neon oder selbst gehostet).
# Bei Supabase: Project Settings -> Database -> Connection string -> URI.
# Das [YOUR-PASSWORD] darin durch das echte Datenbank-Passwort ersetzen.
DATABASE_URL=postgres://user:passwort@host:5432/datenbank

# Optional. Wird auf Vercel von der Supabase- und Neon-Integration automatisch
# gesetzt; dann muss hier nichts eingetragen werden.
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Optional: Ohne SMTP zeigt die App den Passwort-Link direkt an, statt ihn zu mailen.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
